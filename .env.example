# 1. Banco de Dados PostgreSQL 18
POSTGRES_USER=itgames_user
POSTGRES_PASSWORD=itgames_password_prod_2026
POSTGRES_DB=itgames_db
POSTGRES_PORT=5433

# 2. Segurança & Criptografia JWT
JWT_SECRET=itgames_jwt_super_secret_production_key_2026_crossfit_hyrox

# Chave que criptografa a senha SMTP guardada no banco (aba "E-mails" do admin).
# Se vazia, usa o JWT_SECRET. Trocar esta chave invalida a senha SMTP salva (é preciso digitá-la de novo).
MAIL_ENCRYPTION_KEY=

# 3. Portas Expostas no Host
API_PORT=3334
FRONTEND_PORT=3000

# 4. CORS e URLs
# Como o frontend e a API estão na mesma stack:
# - Se deixado vazio (""), o frontend detecta automaticamente o IP/domínio acessado no navegador na porta 3334
# - Ou defina explicitamente com o IP/domínio público do seu servidor (ex: http://192.168.1.100:3334 ou https://api.seudominio.com.br)
NEXT_PUBLIC_API_URL=
CORS_ORIGIN=*
